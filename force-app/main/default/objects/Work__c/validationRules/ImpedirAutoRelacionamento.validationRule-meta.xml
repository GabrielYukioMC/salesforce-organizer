<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ImpedirAutoRelacionamento</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(ParentWork__c)), ParentWork__c = Id)</errorConditionFormula>
    <errorDisplayField>ParentWork__c</errorDisplayField>
    <errorMessage>Uma Work não pode ser sua própria Work pai.</errorMessage>
</ValidationRule>
