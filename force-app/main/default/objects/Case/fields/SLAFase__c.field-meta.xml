<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SLAFase__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
    IsClosed,
    &quot;Concluído&quot;,
    IF(
        IsStopped,
        &quot;Pausado&quot;,
        IF(
            ISBLANK(PrimeiroAtendimentoEm__c),
            &quot;Atendimento&quot;,
            IF(
                ISBLANK(FimTrabalhoSLA__c),
                &quot;Trabalho&quot;,
                &quot;Concluído&quot;
            )
        )
    )
)</formula>
    <label>Fase do SLA</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
