<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ValidarWorkPrincipal</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Work__c)), NOT(ISBLANK(Work__r.ParentWork__c)))</errorConditionFormula>
    <errorDisplayField>Work__c</errorDisplayField>
    <errorMessage>Selecione uma Work principal, sem Work pai.</errorMessage>
</ValidationRule>
