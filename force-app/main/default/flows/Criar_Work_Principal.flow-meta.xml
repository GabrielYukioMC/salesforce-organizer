<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <decisions>
        <name>Verificar_Case</name>
        <label>Verificar Case e Work existente</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Criar_Work</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Case disponível</defaultConnectorLabel>
        <rules>
            <name>Sem_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Buscar_Case.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Case_Invalido</targetReference>
            </connector>
            <label>Case não encontrado</label>
        </rules>
        <rules>
            <name>Com_Work</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Buscar_Case.Work__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Work_Existente</targetReference>
            </connector>
            <label>Work já associada</label>
        </rules>
    </decisions>
    <description>Cria uma Work principal e atualiza Case.Work__c, sob demanda e no contexto de acesso do usuário. Nenhuma migração automática de Cases.</description>
    <environments>Default</environments>
    <interviewLabel>Criar Work principal {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Criar Work principal</label>
    <processType>Flow</processType>
    <recordCreates>
        <name>Criar_Work</name>
        <label>Criar Work principal</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Associar_Work</targetReference>
        </connector>
        <inputAssignments>
            <field>Titulo__c</field>
            <value>
                <elementReference>Titulo</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Case__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Responsavel__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Work__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Buscar_Case</name>
        <label>Consultar Case novamente antes de criar</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Verificar_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Associar_Work</name>
        <label>Associar Work ao Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Concluido</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Work__c</field>
            <value>
                <elementReference>Criar_Work</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
